# ==============================================================================
# KIDSTIME KHILGAON - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development.
# On Vercel, add these exact keys under Project Settings > Environment Variables.

# Supabase Project URL (Public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public Key (Public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional: Internal Seed Secret (Used for /api/seed in staging/production)
# INTERNAL_SEED_SECRET=your-random-long-secret-key
